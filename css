*{
    /* margin: 0; */    
    scroll-behavior: smooth;
}


#head{
    background-color: rgb(10, 10, 10);
    padding: 8px;
}

#navheader{
    display: flex;
    gap: 40px;
    padding-right: 30px;
}

.myname{
    color:white;
    padding-left:10%;
}

.about{
    color:white;
    padding-left: 50%;
}

/* -------------------------------------------------------------------------- */
.home-container {
    display: flex;
    align-items: center;
    gap: 13%;
    margin-top: 20px;
    margin-left: 45px;
}



#home {
    width: 40%;
    height: 20%;
    padding: 30px;
    border-radius: 20px;
    background-color: black;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
}

#home:hover {
    background-color: rgb(34, 34, 34);
    transform: translateY(-10px);
}

.headerhome {
    margin-top: -5px;
    color: white;
    font-size: 120px;
}

.headerhomee {
    margin-top: -40px;
    color: white;
    font-size: 60px;
}

.intro {
    text-align: left;
    color: white;
    line-height: 22px;
    font-size: 20px;
    word-spacing: 5px;
    letter-spacing: 3px;
}

.mainpic {
    width: 40%;
    height: 55%;
    object-fit: cover;
    border: rgb(19, 19, 19) solid 5px;
    border-radius: 10px;
}


/* ------------------------------------------------------------------------------------ */

.about{
    color:white;
    text-decoration: none;
}

.about:hover{
    color: rgb(194, 194, 194);
}

.projects{
    color:white;
    text-decoration: none;
}

.projects:hover{
    color:rgb(194, 194, 194);
}

.contact{
