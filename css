}

/* ---------------------------------------------------------------------------------------------------------------------------------------------------------- */

footer {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: black;
    padding: 15px 20px;
    width: 100%;
    box-sizing: border-box;
    border-radius: 25px;
}

.credits {
    color: white;
    margin: 0;
}

.backhome {
    text-decoration: none;
    color: white;
    padding: 15px;
}


/* ---------------------------------------------------------------------------------------------------------------------------------------------------------------- */


@media screen and (max-width: 768px) {

    /* NAVIGATION */
    #navheader {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
        padding: 15px;
    }

    .myname {
        padding-left: 0;
    }

    .about {
        padding-left: 0;
    }

    /* HOME SECTION */
    .home-container {
        flex-direction: column;
        align-items: center;
        gap: 30px;
        margin: 20px;
    }

    #home {
        width: 85%;
        height: auto;
        padding: 25px;
        box-sizing: border-box;
    }

    .headerhome {
        font-size: 80px;
    }

    .headerhomee {
        font-size: 45px;
        margin-top: -30px;
    }

    .intro {
        font-size: 17px;
        letter-spacing: 2px;
    }

    .mainpic {
        width: 85%;
        height: auto;
    }

    /* ABOUT SECTION */
    .aboutheadbox {
        margin: 10px;
    }

    .aboutparagraph {
        font-size: 16px;
    }

    /* EDUCATION */
    .scname,
    .course,
    .coursee,
    .yrgrad {
        font-size: 17px;
    }

    /* SKILLS */
    .eskillslist {
        width: 75%;
        font-size: 20px;
    }

    /* ACHIEVEMENTS */
    .achievementbox1 {
        min-height: auto;
        padding: 30px 0;
    }

    .certificate {
        width: 80%;
        height: auto;
    }

    /* PROJECTS */
    .projectshead {
        font-size: 30px;
    }

    .projspara {
        font-size: 20px;
    }

    .vidnames {
        font-size: 25px;
    }

    .videobox {
        flex-direction: column;
        align-items: center;
        gap: 30px;
        margin: 0;
    }

    .videobox video {
        width: 100%;
        max-width: 400px;
        height: auto;
    }

    /* CONTACT */
    .mainco {
        width: 90%;
        height: auto;
        padding-bottom: 15px;
        box-sizing: border-box;
    }

    .contactdesc {
        font-size: 17px;
    }

    .emel,
    .number,
    .fb {
        font-size: 15px;
        max-width: 85%;
        overflow-wrap: anywhere;
        box-sizing: border-box;
        padding: 12px;
    }

    /* FOOTER */
    footer {
        width: 100%;
    }
}


/* =========================================
   MOBILE PHONE RESPONSIVENESS
========================================= */

@media screen and (max-width: 480px) {

    /* GENERAL */
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        overflow-x: hidden;
    }

    /* NAVIGATION */
    #head {
        padding: 12px 5px;
    }

    #navheader {
        justify-content: center;
        gap: 15px;
        padding: 5px;
    }

    #navheader a {
        font-size: 14px;
    }

    .myname {
        font-size: 18px !important;
        font-weight: bold;
    }

    /* HOME */
    .home-container {
        margin: 15px;
        gap: 25px;
    }

    #home {
        width: 100%;
        padding: 20px;
    }

    .headerhome {
        font-size: 60px;
        margin-bottom: 20px;
    }

    .headerhomee {
        font-size: 35px;
        margin-top: -30px;
    }

    .intro {
        font-size: 15px;
        line-height: 25px;
        letter-spacing: 1px;
        word-spacing: 2px;
    }

    .mainpic {
        width: 100%;
        height: auto;
    }

    /* ABOUT */
    .aboutheader {
        font-size: 25px;
    }

    .aboutparagraph {
        font-size: 14px;
        line-height: 23px;
    }

    /* EDUCATION */
    .education {
        font-size: 25px;
    }

    .edupara,
    .skillparag,
    .achievementsdescri {
        font-size: 16px;
    }

    .scname,
    .course,
    .coursee,
    .yrgrad {
        font-size: 15px;
        padding: 12px;
        margin: 12px;
        overflow-wrap: anywhere;
    }

    /* SKILLS */
    .aboutskills {
        padding-left: 10px;
        padding-right: 10px;
    }

    .skillhead {
        font-size: 25px;
    }

    .eskillslist {
        width: 95%;
        font-size: 18px;
        padding: 20px;
    }

    /* ACHIEVEMENTS */
    .aboutachievements {
        font-size: 22px;
        margin-left: 10px;
    }

    .achievementsdescri {
        margin-left: 10px;
    }

    .cd {
        font-size: 20px;
        text-align: center;
    }

    .certificate {
        width: 95%;
        height: auto;
    }

    /* PROJECTS */
    .projectshead {
        font-size: 25px;
        margin-left: 10px;
    }

    .projspara {
        font-size: 16px;
        margin-left: 10px;
    }

    .vidnames {
        font-size: 20px;
        margin-left: 10px;
    }

    .videobox {
        margin: 0 10px;
        gap: 20px;
    }

    .vidparts {
        font-size: 20px;
    }

    .videobox video {
        width: 100%;
        height: auto;
    }

    /* CONTACT */
    .contacthead {
        font-size: 25px;
        margin: 15px;
    }

    .mainco {
        width: calc(100% - 30px);
        margin: 15px;
        height: auto;
        padding: 10px 0;
    }

    .contactdesc {
        font-size: 15px;
        padding: 15px;
    }

    .emel,
    .number,
    .fb {
        font-size: 13px;
        margin: 10px;
        padding: 12px;
        max-width: calc(100% - 20px);
        overflow-wrap: anywhere;
    }

    /* FOOTER */
    footer {
        flex-direction: column;
        gap: 15px;
        text-align: center;
        padding: 20px 10px;
    }

    .credits {
        font-size: 13px;
    }

    .backhome {
        font-size: 14px;
    }

}
